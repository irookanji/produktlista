  "dependencies": {
    "@netlify/blobs": "11.0.3",
    "@netlify/functions": "6.0.0",
    "@preact/signals-react": "3.12.0",
    "idb": "8.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.2",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "husky": "9.1.7",
    "knip": "6.35.1",
    "lint-staged": "17.5.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "lint-staged": {
